  <body>
  <div class="container mt-3">
    <h1>Card with Scrollable Content</h1>

    <h2>Method 1: Scrollable Card Body (Recommended)</h2>
<div class="card" style="width: 18rem;">
    <div class="card-header">Card Header</div>
    <div class="card-body" style="max-height: 200px; overflow-y: auto;">
        <p>Line 1</p>
        <p>Line 2</p>
        <p>Line 3</p>
        <p>Line 4</p>
        <p>Line 5</p>
        <p>Line 6</p>
        <p>Line 7</p>
        <p>Line 8</p>
        <p>Line 9</p>
        <p>Line 10</p>
    </div>
    <div class="card-footer">Card Footer</div>
</div>

<h2>Method 2: Using Bootstrap Utility Classes Only</h2>
<div class="card">
    <div class="card-header">Card Header</div>
    <div class="card-body overflow-auto" style="height: 200px;">
        <p>Content 1</p>
        <p>Content 2</p>
        <p>Content 3</p>
        <!-- More content... -->
    </div>
    <div class="card-footer">Card Footer</div>
</div>


<!-- ------------------------------------------------------------ -->
</div>


